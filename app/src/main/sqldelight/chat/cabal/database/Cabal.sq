CREATE TABLE cabal (
    key TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL
);

CREATE TABLE message (
    hash BLOB NOT NULL PRIMARY KEY,
    publicKey BLOB NOT NULL,
    channel TEXT NOT NULL,
    timestamp INTEGER NOT NULL,
    text TEXT NOT NULL,
    rawPost BLOB NOT NULL, -- The original signed post bytes
    status INTEGER NOT NULL DEFAULT 0 -- 0: Sending, 1: Sent to network, 2: Confirmed
);

CREATE INDEX message_channel_timestamp ON message(channel, timestamp);

insertCabal:
INSERT OR IGNORE INTO cabal(key, name)
VALUES (?, ?);

getAllCabals:
SELECT * FROM cabal;

insertMessage:
INSERT OR IGNORE INTO message(hash, publicKey, channel, timestamp, text, rawPost, status)
VALUES (?, ?, ?, ?, ?, ?, ?);

updateMessageStatus:
UPDATE message SET status = ? WHERE hash = ?;

getMessagesByChannel:
SELECT * FROM message
WHERE channel = ?
ORDER BY timestamp ASC;

getMessagesByHashes:
SELECT * FROM message
WHERE hash IN ?;

getMessagesInRange:
SELECT * FROM message
WHERE channel = :channel AND timestamp >= :timeStart AND (timestamp <= :timeEnd OR :timeEnd = 0)
ORDER BY timestamp ASC
LIMIT :limit;
